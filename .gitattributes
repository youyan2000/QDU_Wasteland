# 统一换行符，避免 Windows 上编辑后脚本在 Linux 服务器上崩溃
# 背景：若 .sh 含 CRLF，Linux 上 bash 解析报错（"$'\r': command not found"），
#      会导致 cron 备份脚本、部署脚本静默失败。

# Linux 上执行的脚本必须 LF
*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf

# Go / 配置 / 工作流统一 LF
*.go          text eol=lf
*.mod         text eol=lf
*.sum         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf

# Windows 脚本保持 CRLF（PowerShell 需 UTF-8 BOM + CRLF 最稳）
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# 二进制文件不做换行符转换
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.gif         binary
*.ico         binary
*.svg         text eol=lf
*.xlsx        binary
*.db          binary
*.zip         binary
