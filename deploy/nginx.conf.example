# Optional direct-origin Nginx profile (not the preferred Tunnel topology).
# Install as a file included inside nginx's http {} context, e.g. conf.d/qdu-wasteland.conf.
# Replace the example host and provision a certificate before enabling TLS listeners.
# The Go application must listen only on 127.0.0.1:3000.
# If DNS is proxied by Cloudflare, $remote_addr is a CF edge, not the visitor;
# use the Tunnel profile or add maintained official CF CIDRs + firewall allowlisting first.

server_tokens off;
limit_req_zone $binary_remote_addr zone=qw_direct_rate:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=qw_direct_conn:10m;
limit_req_status 429;

# Reject unknown HTTP hosts. Named HTTP traffic gets a fixed canonical redirect.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name qdwasteland.top www.qdwasteland.top;
    return 301 https://qdwasteland.top$request_uri;
}

# Default TLS virtual host: use the same valid certificate to make this config load,
# then reject requests with unknown SNI/Host rather than serving the application.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/qdwasteland.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qdwasteland.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:QW_TLS:10m;
    ssl_session_timeout 1d;

    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name qdwasteland.top www.qdwasteland.top;

    ssl_certificate     /etc/letsencrypt/live/qdwasteland.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qdwasteland.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:QW_TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 220m;
    client_body_timeout 60s;
    send_timeout 120s;

    location / {
        limit_req zone=qw_direct_rate burst=40 nodelay;
        limit_conn qw_direct_conn 20;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Direct-origin profile: use the TCP peer, never an untrusted forwarding header.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 300s;
    }
}
